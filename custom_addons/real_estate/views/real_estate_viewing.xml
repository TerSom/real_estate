<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="real_estate_viewing_action" model="ir.actions.act_window">
        <field name="name">Real Estate Viewing</field>
        <field name="res_model">real.estate.viewing</field>
        <field name="view_mode">calendar,list,form</field>
    </record>

    <record id="real_estate_viewing_view_form" model="ir.ui.view">
        <field name="name">real.estate.viewing.view.form</field>
        <field name="model">real.estate.viewing</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Done" name="action_done" type="object" class="oe_highlight" invisible="state != 'scheduled'"/>
                    <button string="Cancel" name="action_cancelled" type="object" invisible="state != 'scheduled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="property_id"></field>
                        <field name="partner_id"></field>
                        <field name="agent_id"></field>
                        <field name="date_start"></field>
                        <field name="date_stop"></field>
                        <field name="duration"></field>
                        <field name="state"></field>
                        <field name="note"></field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_viewing_view_list" model="ir.ui.view">
        <field name="name">real.estate.viewing.view.list</field>
        <field name="model">real.estate.viewing</field>
        <field name="arch" type="xml">
            <list >
                <field name="property_id"></field>
                <field name="partner_id"></field>
                <field name="agent_id"></field>
                <field name="date_start"></field>
                <field name="date_stop"></field>
                <field name="duration"></field>
                <field name="state"></field>
                <field name="note"></field>
            </list>
        </field>
    </record>

    <record id="real_estate_viewing_view_calendar" model="ir.ui.view">
        <field name="name">real.estate.viewing.view.calendar</field>
        <field name="model">real.estate.viewing</field>
        <field name="arch" type="xml">
            <calendar string="Survey Schedule" date_start="date_start" date_stop="date_stop" color="agent_id" mode="week" quick_create="0">
                <field name="property_id"/>
                <field name="partner_id"/>
            </calendar>
        </field>
    </record>

</odoo>
