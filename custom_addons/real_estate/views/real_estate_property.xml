<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- action -->
    <record id="real_estate_property_action" model="ir.actions.act_window">
        <field name="name">real_estate_property</field>
        <field name="res_model">real.estate.property</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <!-- Form View -->
    <record id="real_estate_property_view_form" model="ir.ui.view">
        <field name="name">real.estate.property.view.form</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"></field>
                            <field name="description"></field>
                            <field name="postcode"></field>
                            <field name="expected_price"></field>
                            <field name="bedrooms"></field>
                            <field name="type_id"></field>
                        </group>
                        <group>
                            <field name="living_area"></field>
                            <field name="garden"></field>
                            <field name="date_availability"></field>
                            <field name="state"></field>
                            <field name="active"></field>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"></field>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="real_estate_property_view_list" model="ir.ui.view">
        <field name="name">real.estate.property.view.list</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"></field>
                <field name="postcode"></field>
                <field name="expected_price"></field>
                <field name="date_availability"></field>
                <field name="state"></field>
            </list>
        </field>
    </record>
</odoo>