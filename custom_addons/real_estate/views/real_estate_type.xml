<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="real_estate_type_action" model="ir.actions.act_window">
        <field name="name">real.rstate.type</field>
        <field name="res_model">real.estate.type</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>


    <record id="real_estate_type_view_form" model="ir.ui.view">
        <field name="name">real.estate.type.view.form</field>
        <field name="model">real.estate.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_properties" type="object" class="oe_stat_button" icon="fa-home">
                            <field name="property_count" string="Properties" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"></field>
                        <field name="sequence"></field>
                    </group>
                    <notebook>
                        <page name="Properties" string="Properties">
                            <field name="property_ids">
                                <list>
                                    <field name="name"></field>
                                    <field name="postcode"></field>
                                    <field name="expected_price"></field>
                                    <field name="date_availability"></field>
                                    <field name="state"></field>
                                    <field name="bedrooms"></field>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_type_view_list" model="ir.ui.view">
        <field name="name">real.estate.type.view.list</field>
        <field name="model">real.estate.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"></field>
                <field name="sequence"></field>
            </list>
        </field>
    </record>

</odoo>
