<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="real_estate_offer_action" model="ir.actions.act_window">
        <field name="name">Property Offers</field>
        <field name="res_model">real.estate.offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record id="real_estate_offer_view_form" model="ir.ui.view">
        <field name="name">real.estate.offer.view.form</field>
        <field name="model">real.estate.offer</field>
        <field name="arch" type="xml">
            <form string="Property Offer">
                <header>
                    <button name="action_accept" string="Accept" type="object" class="oe_highlight" invisible="state in ['accepted', 'refused']"/>
                    <button name="action_refuse" string="Refuse" type="object" invisible="state in ['accepted', 'refused']"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="partner_id"/>
                        <field name="property_id"/>
                        <field name="price"/>
                        <field name="validity_days"/>
                        <field name="date_deadline"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_offer_view_list" model="ir.ui.view">
        <field name="name">real.estate.offer.view.list</field>
        <field name="model">real.estate.offer</field>
        <field name="arch" type="xml">
            <list string="Property Offers" decoration-danger="state == 'refused'" decoration-success="state == 'accepted'">
                <field name="currency_id" column_invisible="True"/>
                <field name="property_id" decoration-bf="1"/>
                <field name="partner_id"/>
                <field name="price"/>
                <field name="validity_days"/>
                <field name="date_deadline"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'accepted'"
                       decoration-danger="state == 'refused'"/>
            </list>
        </field>
    </record>

</odoo>
