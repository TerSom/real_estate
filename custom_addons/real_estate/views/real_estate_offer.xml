<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="real_estate_offer_action" model="ir.actions.act_window">
        <field name="name">Real Estate Offer</field>
        <field name="res_model">real.estate.offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record id="real_estate_offer_view_form" model="ir.ui.view">
        <field name="name">real.estate.offer.view.form</field>
        <field name="model">real.estate.offer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id"></field>
                        <field name="price"></field>
                        <field name="state"></field>
                        <field name="validity_days"></field>
                        <field name="date_deadline"></field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_offer_view_list" model="ir.ui.view">
        <field name="name">real.estate.offer.view.list</field>
        <field name="model">real.estate.offer</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"></field>
                <field name="price"></field>
                <field name="state"></field>
                <field name="validity_days"></field>
                <field name="date_deadline"></field>
            </list>
        </field>
    </record>

</odoo>
