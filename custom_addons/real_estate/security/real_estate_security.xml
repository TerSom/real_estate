<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="real_estate_property_category_security" model="ir.module.category">
        <field name="name">Real Estate</field>
    </record>

    <record id="group_real_estate_agent" model="res.groups">
        <field name="name">Agent</field>
        <field name="category_id" ref="real_estate_property_category_security"></field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"></field>
    </record>

    <record id="rule_real_estate_agent" model="ir.rule">
        <field name="name">Agent: Own Properties</field>
        <field name="model_id" ref="model_real_estate_property"/>
        <field name="groups" eval="[(4, ref('group_real_estate_agent'))]"/>
        <field name="domain_force">[('agent_id', '=', user.id)]</field>
    </record>

    <record id="group_real_estate_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="real_estate_property_category_security"/>
        <field name="implied_ids" eval="[(4, ref('group_real_estate_agent'))]"/>
    </record>

    <record id="rule_real_estate_manager" model="ir.rule">
        <field name="name">Manager: All Properties</field>
        <field name="model_id" ref="model_real_estate_property"/>
        <field name="groups" eval="[(4, ref('group_real_estate_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
