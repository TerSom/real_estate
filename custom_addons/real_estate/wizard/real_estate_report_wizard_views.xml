<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="real_estate_report_wizard_view_form" model="ir.ui.view">
        <field name="name">real.estate.report.wizard.view.form</field>
        <field name="model">real.estate.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Property Report">
                <sheet>
                    <group invisible="file_data">
                        <group string="Filter Criteria">
                            <field name="state"/>
                            <field name="type_id"/>
                            <field name="agent_id"/>
                        </group>
                        <group string="Availability Period">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group invisible="not file_data" string="Download Report">
                        <field name="file_data" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate" string="Generate Report" type="object" class="oe_highlight" invisible="file_data"/>
                    <button name="action_generate" string="Regenerate" type="object" class="btn-secondary" invisible="not file_data"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Menu Action -->
    <record id="action_real_estate_report_wizard" model="ir.actions.act_window">
        <field name="name">Property Excel Report</field>
        <field name="res_model">real.estate.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Contextual Action in List View -->
    <record id="action_real_estate_report_wizard_list" model="ir.actions.act_window">
        <field name="name">Export to Excel</field>
        <field name="res_model">real.estate.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_real_estate_property"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
